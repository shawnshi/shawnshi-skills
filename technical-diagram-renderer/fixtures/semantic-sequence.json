{
  "template_type": "sequence",
  "style": 4,
  "title": "Clinical Query Sequence",
  "participants": [
    {"id": "doctor", "label": "Doctor"},
    {"id": "copilot", "label": "Clinical Copilot"},
    {"id": "record", "label": "Patient Record"}
  ],
  "lifelines": [
    {"participant": "doctor"},
    {"participant": "copilot"},
    {"participant": "record"}
  ],
  "messages": [
    {"from": "doctor", "to": "copilot", "label": "Ask question", "type": "sync"},
    {"from": "copilot", "to": "record", "label": "Fetch context", "async": true},
