                        "read one paper with evidence needed for the question",
                        "review one paper identity methods and results",
                        "trace one paper lineage"
                    ],
                    "should_not_trigger_signals": [
                        "non-paper longform argument analysis",
                        "video subtitles or transcript analysis",
                        "simple non-paper summary or compression"
                    ]
