{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/run-metrics.schema.json",
  "title": "discovery-call run metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "run_id",
    "business_mode",
    "started_at",
    "ended_at",
    "elapsed_ms",
    "counters"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-run-metrics/v1"
    },
    "context_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "business_mode": {
      "enum": [
        "briefing",
        "standard_visit",
        "strategic_account",
        "letter"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_user_turns",
        "queries_planned",
        "queries_executed",
        "cache_hits",
        "cache_misses",
        "sources_opened",
        "sources_accepted",
        "claims_created",
        "claims_reused",
        "files_persisted",
        "files_delivered",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "formal_user_turns": {
          "type": "integer",
          "minimum": 0
        },
        "queries_planned": {
          "type": "integer",
          "minimum": 0
        },
        "queries_executed": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "minimum": 0
        },
        "sources_opened": {
          "type": "integer",
          "minimum": 0,
          "description": "For explicitly declared current semantics: business original-source read requests including failures and rereads; excludes hash-byte reads and rule/Skill reads. Legacy values may have unknown semantics; consult counter_semantics."
        },
        "sources_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "claims_created": {
          "type": "integer",
          "minimum": 0
        },
        "claims_reused": {
          "type": "integer",
          "minimum": 0
        },
        "files_persisted": {
          "type": "integer",
          "minimum": 0
        },
        "files_delivered": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "unmeasured_counters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "这些计数器未观测；其兼容性默认0不得解释为实际零次。"
    },
    "measurement_scope": {
      "type": "string",
      "enum": [
        "post_skill_read_to_precommit_snapshot",
        "legacy_recorded_start_to_precommit_snapshot"
      ],
      "description": "Optional for legacy v1 files; absence means interval coverage is unspecified, never end-to-end."
    },
    "coverage_exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "counter_semantics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "New sessions explicitly declare current counting rules. Missing legacy semantics remain unknown; historical counts must not be reinterpreted as current-rule counts."
    },
    "event_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_source_open": {
          "type": "integer",
          "minimum": 0
        },
        "hash_bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "rule_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
