{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/request-binding-receipt.schema.json",
  "title": "Host-issued raw request and mention-ledger binding receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "issuer", "audience", "key_id", "receipt_id", "issued_at", "expires_at",
    "request_id", "business_mode", "request_actor_id", "request_bundle_id", "request_revision",
    "ordered_request_event_ids", "last_user_event_id", "capture_method",
    "normalization_method", "raw_request_sha256", "raw_request_length",
    "attachment_manifest_sha256", "attachment_count", "mention_ledger_sha256",
    "subject_resolution_sha256", "safety_authorizations_sha256",
    "safety_directive_policy", "safety_coverage_complete", "safety_directives_sha256",
    "safety_directive_count", "safety_directives",
    "mention_count", "extractor_id", "extractor_version", "extraction_policy_sha256",
    "coverage_policy", "coverage_complete", "mentions", "signature"
  ],
  "properties": {
    "schema": {"const": "discovery-call-request-binding-receipt/v2"},
    "issuer": {"$ref": "#/$defs/id"},
    "audience": {"const": "discovery-call-request-binding"},
    "key_id": {"$ref": "#/$defs/id"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
    "business_mode": {"enum": ["briefing", "standard_visit", "strategic_account", "letter"]},
    "request_actor_id": {"$ref": "#/$defs/id"},
    "request_bundle_id": {"$ref": "#/$defs/id"},
    "request_revision": {"type": "integer", "minimum": 1},
    "ordered_request_event_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "last_user_event_id": {"$ref": "#/$defs/id"},
    "capture_method": {"const": "authenticated_host_message_bundle"},
    "normalization_method": {"const": "unicode-nfc-lf-utf8/v1"},
    "raw_request_sha256": {"$ref": "#/$defs/sha256"},
    "raw_request_length": {"type": "integer", "minimum": 1, "maximum": 262144},
    "attachment_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_count": {"type": "integer", "minimum": 0},
    "mention_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "subject_resolution_sha256": {"$ref": "#/$defs/sha256"},
    "safety_authorizations_sha256": {"$ref": "#/$defs/sha256"},
    "safety_directive_policy": {"const": "discovery-call-letter-safety-directives/v1"},
    "safety_coverage_complete": {"const": true},
    "safety_directives_sha256": {"$ref": "#/$defs/sha256"},
    "safety_directive_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "safety_directives": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/safety_directive"}
    },
    "mention_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "extractor_id": {"$ref": "#/$defs/id"},
    "extractor_version": {"$ref": "#/$defs/id"},
    "extraction_policy_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_policy": {"const": "discovery-call-high-impact-occurrences/v2"},
    "coverage_complete": {"const": true},
    "mentions": {
      "type": "array", "maxItems": 200,
      "items": {"$ref": "#/$defs/mention"}
    },
    "signature": {"type": "string", "minLength": 86, "maxLength": 88}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "date_anchor": {"type": "string", "format": "date"}
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_id", "semantic_slot", "candidate_field", "source_event_id", "char_start", "char_end",
        "surface_sha256", "normalized_value", "assertion_status", "source_ref"
      ],
      "properties": {
        "mention_id": {"$ref": "#/$defs/id"},
        "semantic_slot": {
          "enum": [
            "organization", "person", "role", "meeting_time", "project_id",
            "meeting_status", "recipient_identity", "recipient_role",
            "visit_objective", "minimum_next_step", "strategic_question",
            "planning_horizon", "letter_scenario", "letter_purpose",
            "expected_action", "signer", "delivery_channel"
          ]
        },
        "candidate_field": {
          "enum": [
            "customer_name", "organization_scope", "target_person", "target_role",
            "target_contact_level", "meeting_status", "meeting_time", "project_id",
            "recipient_identity", "recipient_role", "visit_objective",
            "minimum_next_step", "strategic_question", "planning_horizon",
            "letter_scenario", "letter_purpose", "expected_action", "signer",
            "delivery_channel"
          ]
        },
        "source_event_id": {"$ref": "#/$defs/id"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1},
        "surface_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_value": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 500},
            {"$ref": "#/$defs/time_value"},
            {"type": "null"}
          ]
        },
        "assertion_status": {
          "enum": ["asserted", "uncertain", "explicit_unknown", "negated", "quoted", "superseded"]
        },
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {
          "if": {
            "properties": {"assertion_status": {"const": "explicit_unknown"}},
            "required": ["assertion_status"]
          },
          "then": {"properties": {"normalized_value": {"type": "null"}}},
          "else": {"properties": {"normalized_value": {"not": {"type": "null"}}}}
        }
      ]
    },
    "safety_directive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "risk_code", "assertion_status", "source_event_id", "char_start", "char_end", "surface_sha256", "source_ref"],
      "properties": {
        "directive_id": {"$ref": "#/$defs/id"},
        "risk_code": {"enum": ["fabricated_approval", "unauthorized_patient_information", "unauthorized_internal_source", "unverified_delivery_timeline", "unverified_outcome_claim", "unapproved_price_cap", "direct_external_send", "nonhuman_accountability"]},
        "assertion_status": {"enum": ["asserted", "uncertain", "explicit_unknown", "negated", "quoted", "superseded"]},
        "source_event_id": {"$ref": "#/$defs/id"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1},
        "surface_sha256": {"$ref": "#/$defs/sha256"},
        "material_scope_sha256": {"$ref": "#/$defs/sha256"},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "risk_code": {
                "enum": ["unauthorized_patient_information", "unauthorized_internal_source"]
              }
            },
            "required": ["risk_code"]
          },
          "then": {"required": ["material_scope_sha256"]},
          "else": {"not": {"required": ["material_scope_sha256"]}}
        }
      ]
    }
  }
}
