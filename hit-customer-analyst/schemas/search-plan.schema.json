{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/search-plan.schema.json",
  "title": "discovery-call offline search plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "run_id",
    "business_mode",
    "route",
    "depth",
    "customer_id",
    "organization_scope",
    "selected_modules",
    "generated_at",
    "planning_ready",
    "gate_results",
    "budgets",
    "queries",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-search-plan/v1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^dcx-[0-9]{8}-[A-Za-z0-9]{8}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"
    },
    "business_mode": {
      "enum": [
        "briefing",
        "standard_visit",
        "strategic_account",
        "letter"
      ]
    },
    "route": {
      "enum": [
        "visit_prep",
        "strategy",
        "letter"
      ]
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "customer_id": {
      "type": "string",
      "minLength": 3
    },
    "organization_scope": {
      "type": "string",
      "minLength": 1
    },
    "selected_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "institution",
          "leader",
          "internal",
          "strategy",
          "letter"
        ]
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "planning_ready": {
      "type": "boolean"
    },
    "gate_results": {
      "type": "object",
      "required": [
        "passed",
        "failed"
      ],
      "properties": {
        "passed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "query",
        "source",
        "turn",
        "output_pages",
        "ttl_days"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "channel",
          "query_ids"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^BAT-[0-9]{3}$"
          },
          "channel": {
            "enum": [
              "public",
              "internal"
            ]
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^QRY-[0-9a-f]{12}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "channel",
        "purpose",
        "priority",
        "query",
        "normalized_query",
        "cache_key"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^QRY-[0-9a-f]{12}$"
        },
        "channel": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "normalized_query": {
          "type": "string",
          "minLength": 1
        },
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
