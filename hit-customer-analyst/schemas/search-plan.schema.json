{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/search-plan.schema.json",
  "title": "discovery-call offline search plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "run_id",
    "business_mode",
    "route",
    "depth",
    "customer_id",
    "organization_scope",
    "selected_modules",
    "authorization_context",
    "internal_queries_suppressed",
    "generated_at",
    "planning_ready",
    "gate_results",
    "budgets",
    "queries",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-search-plan/v1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^dcx-[0-9]{8}-[A-Za-z0-9]{8}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"
    },
    "business_mode": {
      "enum": [
        "briefing",
        "standard_visit",
        "strategic_account",
        "letter"
      ]
    },
    "route": {
      "enum": [
        "visit_prep",
        "strategy",
        "letter"
      ]
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "customer_id": {
      "type": "string",
      "minLength": 3
    },
    "organization_scope": {
      "type": "string",
      "minLength": 1
    },
    "selected_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "institution",
          "leader",
          "internal",
          "strategy",
          "letter"
        ]
      }
    },
    "strategy_variant": {
      "type": ["string", "null"],
      "enum": ["scheduled_visit", "account_planning", null]
    },
    "authorization_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id", "customer_id", "project_id", "allowed_project_ids",
        "authorization_expires_at", "authorization_owner", "connector_id",
        "authorized_roots", "allowed_dataset_aliases", "allowed_confidentiality",
        "authorization_purpose", "capability_receipt_id"
      ],
      "properties": {
        "tenant_id": {"type": ["string", "null"]},
        "customer_id": {"type": "string"},
        "project_id": {"type": ["string", "null"]},
        "allowed_project_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "authorization_expires_at": {"type": ["string", "null"]},
        "authorization_owner": {"type": ["string", "null"]},
        "connector_id": {"type": ["string", "null"]},
        "authorized_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_dataset_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_confidentiality": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "authorization_purpose": {"type": ["string", "null"]},
        "capability_receipt_id": {"type": ["string", "null"]},
        "authorization_actor_id": {"type": ["string", "null"]},
        "capability_operation": {"const": "internal_read"},
        "capability_receipt_verified": {"type": "boolean"},
        "capability_receipt_issuer": {"type": ["string", "null"]},
        "capability_receipt_key_id": {"type": ["string", "null"]},
        "capability_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "capability_receipt_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "capability_receipt_expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "internal_queries_suppressed": {"type": "boolean"},
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "planning_ready": {
      "type": "boolean"
    },
    "gate_results": {
      "type": "object",
      "required": [
        "passed",
        "failed"
      ],
      "properties": {
        "passed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "query",
        "source",
        "turn",
        "output_pages",
        "ttl_days"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "channel",
          "query_ids"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^BAT-[0-9]{3}$"
          },
          "channel": {
            "enum": [
              "public",
              "internal"
            ]
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^QRY-[0-9a-f]{12}$"
            }
          }
        }
      }
    },
    "intake_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "input_sha256", "business_mode", "evaluated_at", "expires_at"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^dcg-[0-9a-f]{16}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "business_mode": {"enum": ["briefing", "standard_visit", "strategic_account", "letter"]},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "channel",
        "purpose",
        "priority",
        "query",
        "normalized_query",
        "cache_key"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^QRY-[0-9a-f]{12}$"
        },
        "channel": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "normalized_query": {
          "type": "string",
          "minLength": 1
        },
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_modules": {"contains": {"const": "internal"}}
        },
        "required": ["selected_modules"]
      },
      "then": {
        "properties": {
          "authorization_context": {
            "required": [
              "authorization_actor_id", "capability_operation",
              "capability_receipt_verified", "capability_receipt_issuer",
              "capability_receipt_key_id", "capability_receipt_sha256",
              "capability_receipt_verified_at", "capability_receipt_expires_at"
            ]
          }
        }
      }
    }
  ]
}
