{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/evidence-manifest.schema.json",
  "title": "discovery-call evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "run_id",
    "business_mode",
    "customer_id",
    "project_id",
    "updated_at",
    "connector_audit",
    "sources",
    "claims",
    "query_links"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-evidence-manifest/v1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^dcx-[0-9]{8}-[A-Za-z0-9]{8}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"
    },
    "business_mode": {
      "enum": [
        "briefing",
        "standard_visit",
        "strategic_account",
        "letter"
      ]
    },
    "customer_id": {
      "type": "string",
      "minLength": 3
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "connector_audit": {
      "$ref": "#/$defs/connector_audit"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "query_links": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "connector_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "connector_id",
        "call_id",
        "called_at",
        "tenant_id",
        "customer_id",
        "project_id",
        "allowed_project_ids",
        "authorization_owner",
        "authorization_expires_at",
        "server_filter_verified",
        "response_scope_verified",
        "response_fingerprint",
        "isolated_record_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "not_configured",
            "connected",
            "no_hits",
            "permission_denied",
            "failed"
          ]
        },
        "connector_id": {
          "type": ["string", "null"]
        },
        "call_id": {
          "type": ["string", "null"]
        },
        "called_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "tenant_id": {
          "type": ["string", "null"]
        },
        "customer_id": {
          "type": ["string", "null"]
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "allowed_project_ids": {
          "type": "array",
          "uniqueItems": true,
          "description": "真实调用时必须包含同对象的project_id；动态成员相等性由commit_run运行时校验。",
          "items": {"type": "string", "minLength": 3}
        },
        "authorization_owner": {
          "type": ["string", "null"]
        },
        "authorization_expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "server_filter_verified": {
          "type": "boolean"
        },
        "response_scope_verified": {
          "type": "boolean"
        },
        "response_fingerprint": {
          "type": ["string", "null"]
        },
        "isolated_record_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["connected", "no_hits"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "connector_id": {"type": "string", "minLength": 1},
              "call_id": {"type": "string", "minLength": 1},
              "called_at": {"type": "string", "minLength": 1},
              "tenant_id": {"type": "string", "minLength": 3},
              "customer_id": {"type": "string", "minLength": 3},
              "project_id": {"type": "string", "minLength": 3},
              "allowed_project_ids": {
                "type": "array",
                "minItems": 1,
                "contains": {"type": "string", "minLength": 3}
              },
              "authorization_owner": {"type": "string", "minLength": 1},
              "authorization_expires_at": {"type": "string", "minLength": 1},
              "server_filter_verified": {"const": true},
              "response_scope_verified": {"const": true},
              "response_fingerprint": {"type": "string", "minLength": 3}
            }
          }
        }
      ]
    }
  }
}
