{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/source-cache.schema.json",
  "title": "discovery-call shared source cache",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "run_id",
    "business_mode",
    "updated_at",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-source-cache/v1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^dcx-[0-9]{8}-[A-Za-z0-9]{8}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"
    },
    "business_mode": {
      "enum": ["briefing", "standard_visit", "strategic_account", "letter"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_key",
        "source_title",
        "publisher_or_provider",
        "locator",
        "final_url",
        "canonical_locator",
        "publication_or_update_date",
        "access_date",
        "source_fingerprint",
        "content_sha256",
        "retrieved_at",
        "capture_method",
        "length",
        "published_at",
        "source_updated_at",
        "internal_recorded_at",
        "source_level",
        "source_group",
        "permission",
        "applicable_scope",
        "notes",
        "upstream_id",
        "external_use",
        "tenant_id",
        "project_id",
        "capture_receipt",
        "expires_at",
        "ttl_class",
        "metadata"
      ],
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_title": {"type": "string", "minLength": 1},
        "publisher_or_provider": {"type": "string", "minLength": 1},
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "final_url": {
          "type": "string",
          "minLength": 1
        },
        "canonical_locator": {
          "type": "string",
          "minLength": 1
        },
        "publication_or_update_date": {"type": "string", "minLength": 1},
        "access_date": {"type": "string", "format": "date"},
        "source_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "internal_recorded_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_level": {
          "enum": ["S", "A", "B", "C", "internal"]
        },
        "source_group": {"type": "string", "minLength": 1},
        "permission": {
          "enum": ["public", "internal-authorized", "restricted"]
        },
        "applicable_scope": {"type": "string", "minLength": 1},
        "notes": {"enum": ["none", "capture_limitation", "metadata_unavailable", "scope_limited"]},
        "upstream_id": {"type": "string", "minLength": 1},
        "external_use": {
          "enum": ["true", "false"]
        },
        "tenant_id": {
          "type": ["string", "null"]
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "capture_method": {
          "enum": [
            "raw-bytes-v1",
            "text-nfc-lf-utf8-v1"
          ]
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "capture_receipt": {
          "$ref": "#/$defs/source_capture_receipt"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ttl_class": {
          "enum": [
            "institution",
            "leader",
            "procurement",
            "internal"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "source_capture_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "issuer", "audience", "key_id", "issued_at", "expires_at",
        "receipt_id", "source_id", "source_title", "publisher_or_provider", "locator",
        "final_url", "canonical_locator", "publication_or_update_date", "access_date",
        "content_sha256", "length", "capture_method", "retrieved_at", "published_at",
        "source_updated_at", "internal_recorded_at", "source_level", "source_group",
        "permission", "applicable_scope", "notes", "upstream_id", "external_use",
        "tenant_id", "run_id", "customer_id", "project_id", "signature"
      ],
      "properties": {
        "schema": {"const": "discovery-call-source-capture-receipt/v3"},
        "issuer": {"type": "string", "minLength": 3},
        "audience": {"const": "discovery-call-source-capture"},
        "key_id": {"type": "string", "minLength": 3},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "receipt_id": {"type": "string", "minLength": 3},
        "source_id": {"type": "string", "pattern": "^SRC-(I|L|N)-[0-9]{3,}$"},
        "source_title": {"type": "string", "minLength": 1},
        "publisher_or_provider": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "final_url": {"type": "string", "minLength": 1},
        "canonical_locator": {"type": "string", "minLength": 1},
        "publication_or_update_date": {"type": "string", "minLength": 1},
        "access_date": {"type": "string", "format": "date"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "length": {"type": "integer", "minimum": 0},
        "capture_method": {"enum": ["raw-bytes-v1", "text-nfc-lf-utf8-v1"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
        "internal_recorded_at": {"type": ["string", "null"], "format": "date-time"},
        "source_level": {"enum": ["S", "A", "B", "C", "internal"]},
        "source_group": {"type": "string", "minLength": 1},
        "permission": {"enum": ["public", "internal-authorized", "restricted"]},
        "applicable_scope": {"type": "string", "minLength": 1},
        "notes": {"enum": ["none", "capture_limitation", "metadata_unavailable", "scope_limited"]},
        "upstream_id": {"type": "string", "minLength": 1},
        "external_use": {"enum": ["true", "false"]},
        "tenant_id": {"type": ["string", "null"]},
        "run_id": {"type": "string", "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"},
        "customer_id": {"type": "string", "minLength": 3},
        "project_id": {"type": ["string", "null"]},
        "signature": {"type": "string", "minLength": 80}
      }
    }
  }
}
