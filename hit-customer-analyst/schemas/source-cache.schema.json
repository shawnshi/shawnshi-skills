{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/source-cache.schema.json",
  "title": "discovery-call shared source cache",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-source-cache/v1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_key",
        "locator",
        "canonical_locator",
        "source_fingerprint",
        "content_sha256",
        "fetched_at",
        "expires_at",
        "ttl_class",
        "metadata"
      ],
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "canonical_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ttl_class": {
          "enum": [
            "institution",
            "leader",
            "procurement",
            "internal"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
