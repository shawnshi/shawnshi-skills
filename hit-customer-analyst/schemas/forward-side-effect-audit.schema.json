{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/forward-side-effect-audit.schema.json",
  "title": "host-observed discovery-call side-effect audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evaluation_id", "slot_id", "run_id", "context_id", "host_session_id",
    "capture_source", "capture_complete", "workspace_before_sha256", "workspace_after_sha256",
    "file_changes", "external_effects"
  ],
  "properties": {
    "schema": {"const": "discovery-call-forward-side-effect-audit/v1"},
    "evaluation_id": {"type": "string", "minLength": 6},
    "slot_id": {"type": "string", "minLength": 6},
    "run_id": {"type": "string", "minLength": 6},
    "context_id": {"type": "string", "minLength": 6},
    "host_session_id": {"type": "string", "minLength": 6},
    "capture_source": {"const": "host_observer"},
    "capture_complete": {"const": true},
    "workspace_before_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_after_sha256": {"$ref": "#/$defs/sha256"},
    "file_changes": {"type": "array", "items": {"type": "object"}},
    "external_effects": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
