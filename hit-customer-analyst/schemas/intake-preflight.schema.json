{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/intake-preflight.schema.json",
  "title": "discovery-call structured intake preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "business_mode",
    "candidate_sets",
    "confirmations",
    "request_binding",
    "subject_resolution",
    "safety_authorizations"
  ],
  "properties": {
    "schema": {
      "const": "discovery-call-intake/v3"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,128}$"
    },
    "business_mode": {
      "enum": [
        "briefing",
        "standard_visit",
        "strategic_account",
        "letter"
      ]
    },
    "candidate_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate_set"
      }
    },
    "confirmations": {
      "type": "array",
      "maxItems": 0,
      "description": "模型可写intake不得内嵌自报确认；冲突须由认证宿主核验后重建单一候选intake。",
      "items": {
        "$ref": "#/$defs/confirmation"
      }
    },
    "request_binding": {
      "$ref": "#/$defs/request_binding"
    },
    "subject_resolution": {
      "$ref": "#/$defs/subject_resolution"
    },
    "safety_authorizations": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/safety_authorization"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "subject_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "attestation_id", "issuer", "customer_id", "canonical_customer_name", "canonical_entity_key", "jurisdiction", "canonical_subject_sha256", "organization_scope_sha256", "id_source", "evidence_sha256", "issued_at", "expires_at"],
      "properties": {
        "schema": {"const": "discovery-call-subject-resolution/v1"},
        "attestation_id": {"$ref": "#/$defs/id"},
        "issuer": {"$ref": "#/$defs/id"},
        "customer_id": {"$ref": "#/$defs/id"},
        "canonical_customer_name": {"type": "string", "minLength": 1, "maxLength": 500},
        "canonical_entity_key": {"$ref": "#/$defs/id"},
        "jurisdiction": {"$ref": "#/$defs/id"},
        "canonical_subject_sha256": {"$ref": "#/$defs/sha256"},
        "organization_scope_sha256": {"$ref": "#/$defs/sha256"},
        "id_source": {"enum": ["host_attested_external", "canonical_derived"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "safety_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authorization_id", "issuer", "risk_code", "subject_sha256", "request_bundle_id", "request_revision", "material_scope_sha256", "purpose", "external_allowed", "evidence_sha256", "issued_at", "expires_at"],
      "properties": {
        "schema": {"const": "discovery-call-safety-authorization/v1"},
        "authorization_id": {"$ref": "#/$defs/id"},
        "issuer": {"$ref": "#/$defs/id"},
        "risk_code": {"enum": ["unauthorized_patient_information", "unauthorized_internal_source"]},
        "subject_sha256": {"$ref": "#/$defs/sha256"},
        "request_bundle_id": {"$ref": "#/$defs/id"},
        "request_revision": {"type": "integer", "minimum": 1},
        "material_scope_sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "internal_review_draft"},
        "external_allowed": {"const": false},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "request_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "request_bundle_id",
        "request_revision",
        "raw_request_sha256",
        "raw_request_file",
        "receipt_file"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "request_bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "raw_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_request_file": {
          "type": "string",
          "pattern": "^[^/\\\\]{1,255}$"
        },
        "receipt_file": {
          "type": "string",
          "pattern": "^[^/\\\\]{1,255}$"
        }
      }
    },
    "field": {
      "enum": [
        "customer_name",
        "organization_scope",
        "target_person",
        "target_role",
        "target_contact_level",
        "meeting_status",
        "meeting_time",
        "project_id",
        "recipient_identity",
        "recipient_role",
        "visit_objective",
        "minimum_next_step",
        "strategic_question",
        "planning_horizon",
        "strategy_variant",
        "letter_scenario",
        "letter_purpose",
        "expected_action",
        "signer",
        "delivery_channel"
      ]
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "value",
        "status",
        "source_ref",
        "mention_ids"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{3,128}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "$ref": "#/$defs/time_range"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "asserted",
            "explicit_unknown"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "mention_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "explicit_unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "$ref": "#/$defs/time_range"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "candidate_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "candidates"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "meeting_status"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "candidates": {
                "items": {
                  "properties": {
                    "value": {
                      "enum": [
                        "confirmed",
                        "tentative",
                        "none",
                        "unknown"
                      ]
                    },
                    "status": {
                      "const": "asserted"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "selected_candidate_ids",
        "allow_multiple",
        "confirmed_by",
        "confirmed_at",
        "confirmation_ref"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "selected_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{3,128}$"
          }
        },
        "allow_multiple": {
          "type": "boolean"
        },
        "confirmed_by": {
          "const": "user"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
