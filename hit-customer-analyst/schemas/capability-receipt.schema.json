{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winning-health.example/discovery-call/capability-receipt.schema.json",
  "title": "Host-issued Ed25519 capability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "issuer", "audience", "key_id", "issued_at", "expires_at",
    "receipt_id", "actor_id", "run_id", "connector_id", "operation",
    "tenant_id", "customer_id", "project_id", "allowed_project_ids",
    "authorization_owner", "authorization_expires_at", "authorized_roots",
    "allowed_dataset_aliases", "allowed_confidentiality",
    "authorization_purpose", "signature"
  ],
  "properties": {
    "schema": {"const": "discovery-call-capability-receipt/v1"},
    "issuer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "audience": {"const": "discovery-call-internal"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "run_id": {"type": "string", "pattern": "^dcr-[0-9]{8}T[0-9]{6}-[A-Za-z0-9]{4}$"},
    "connector_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "operation": {"const": "internal_read"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "customer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "allowed_project_ids": {"$ref": "#/$defs/nonempty_unique_strings"},
    "authorization_owner": {"type": "string", "minLength": 1},
    "authorization_expires_at": {"type": "string", "format": "date-time"},
    "authorized_roots": {"$ref": "#/$defs/nonempty_unique_strings"},
    "allowed_dataset_aliases": {"$ref": "#/$defs/nonempty_unique_strings"},
    "allowed_confidentiality": {"$ref": "#/$defs/nonempty_unique_strings"},
    "authorization_purpose": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 86, "maxLength": 88}
  },
  "$defs": {
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
