{
  "$schema": "../schemas/business-modes.schema.json",
  "schema_version": "1.0.0",
  "authorization_contract": {
    "tenant_id": {
      "required": "when_internal_or_connector",
      "stable": true
    },
    "customer_id": {
      "required": "always",
      "stable": true
    },
    "project_id": {
      "required": "when_internal_or_connector",
      "stable": true
    },
    "allowed_project_ids": {
      "required": "when_internal",
      "must_include": "project_id"
    },
    "authorization_expires_at": {
      "required": "when_internal",
      "timezone_required": true
    }
  },
  "profiles": {
    "briefing": {
      "display_name": "会前速览",
      "route": "visit_prep",
      "depth": "quick",
      "modules": [
        "institution",
        "strategy"
      ],
      "optional_modules": [
        "leader",
        "internal"
      ],
      "query_budget": {
        "public_max": 12,
        "internal_max": 8,
        "batch_size": 4,
        "parallelism": 3
      },
      "source_budget": {
        "min": 3,
        "max": 5
      },
      "turn_budget": {
        "formal_max": 1,
        "questions_per_turn_max": 3
      },
      "output_pages": {
        "min": 1,
        "max": 1
      },
      "ttl_days": {
        "institution": 90,
        "leader": 14,
        "procurement": 7,
        "internal": 30
      },
      "required_business_fields": [
        "customer_name",
        "organization_scope",
        "target_contact_level",
        "visit_objective",
        "minimum_next_step"
      ],
      "authorization_requirements": {
        "stable_ids": [
          "customer_id"
        ],
        "internal_stable_ids": [
          "tenant_id",
          "customer_id",
          "project_id"
        ],
        "project_allowlist_required_for_internal": true,
        "authorization_expiry_required_for_internal": true
      },
      "planning_gate": {
        "required": [
          "business_fields_complete",
          "stable_customer_id",
          "route_depth_compatible",
          "query_budget_valid",
          "output_contract_resolved"
        ],
        "conditional": {
          "leader_selected": [
            "target_identity_or_role_resolved"
          ],
          "internal_selected": [
            "tenant_customer_project_ids_stable",
            "project_authorized",
            "authorization_current"
          ]
        }
      },
      "query_templates": [
        {
          "id": "subject",
          "channel": "public",
          "scope": "customer",
          "priority": 10,
          "template": "{subject} 官网 主管单位 机构职责"
        },
        {
          "id": "current-task",
          "channel": "public",
          "scope": "customer",
          "priority": 20,
          "template": "{subject} {year} 重点工作 数字化 信息化"
        },
        {
          "id": "procurement",
          "channel": "public",
          "scope": "customer",
          "priority": 30,
          "template": "{subject} 信息化 采购 中标 合同 验收"
        },
        {
          "id": "person-role",
          "channel": "public",
          "scope": "person",
          "priority": 15,
          "template": "{subject} {person} 职务 分工"
        },
        {
          "id": "internal-signal",
          "channel": "internal",
          "scope": "customer",
          "priority": 10,
          "template": "{subject} 项目 阶段 需求 风险 下一步"
        }
      ]
    },
