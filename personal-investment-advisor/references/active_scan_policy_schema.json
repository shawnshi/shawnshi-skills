{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pia-active-scan-policy-v1",
  "type": "object",
  "required": ["schema_version", "required_components", "component_weights", "max_component_age_days", "minimum_confidence", "uncertainty_penalty_multiplier", "retain_count"],
  "properties": {
    "schema_version": {"const": "pia_active_scan_policy_v1"},
    "required_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "component_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
    "max_component_age_days": {"type": "number", "exclusiveMinimum": 0},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_penalty_multiplier": {"type": "number", "minimum": 0},
    "retain_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
