{
  "resource_kind": "research_brief_contract",
  "version": "1.1",
  "required_top_level": [
    "research_id",
    "instrument",
    "as_of_date",
    "investment_horizon_days",
    "benchmark",
    "method_profile",
    "research_question",
    "market_consensus",
    "core_hypothesis",
    "falsification_conditions",
    "key_variables",
    "source_policy",
    "output_contract"
  ],
  "required_instrument_fields": [
    "symbol",
    "market",
    "asset_type",
    "currency"
  ],
  "required_benchmark_fields": [
    "symbol",
    "market",
    "currency"
  ],
  "required_source_policy_fields": [
    "cutoff_date",
    "allowed_source_tiers",
    "primary_source_required"
  ],
  "required_output_contract_fields": [
    "decision_scope",
    "required_scenarios",
    "include_counterevidence",
    "transaction_cost_bps",
    "dual_trigger_policy"
  ],
  "enums": {
    "market": ["CN", "HK", "US"],
    "asset_type": ["stock", "etf", "fund", "index", "other"],
    "decision_scope": ["research_only"],
    "industry_type": ["operating_company", "bank", "insurance", "other", "unknown"],
    "dual_trigger_policy": ["conservative", "exclude"],
    "source_tier": [
      "company_primary",
      "regulator",
      "exchange",
      "audited_filing",
      "market_data",
      "secondary",
      "user_authorized"
    ]
  },
  "market_currency": {
    "CN": "CNY",
    "HK": "HKD",
    "US": "USD"
  },
  "strong_types": {
    "non_empty_string_fields": [
      "research_id",
      "method_profile",
      "research_question",
      "market_consensus",
      "core_hypothesis",
      "instrument.symbol",
      "instrument.market",
      "instrument.asset_type",
      "instrument.currency",
      "benchmark.symbol",
      "benchmark.market",
      "benchmark.currency"
    ],
    "string_list_fields": [
      "falsification_conditions",
      "key_variables",
      "source_policy.allowed_source_tiers",
      "output_contract.required_scenarios"
    ],
    "currency_pattern": "^[A-Z]{3}$",
    "investment_horizon_days": "positive_integer_excluding_boolean"
  },
  "key_variable_limits": {
    "minimum": 1,
    "maximum": 20
  }
}
