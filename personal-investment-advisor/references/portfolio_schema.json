{
  "resource_kind": "portfolio_contract",
  "version": "3.0",
  "optional_top_level": ["exchange_rates", "exchange_rate_metadata", "risk_profile"],
  "prohibited_top_level": ["rebalance_policy"],
  "required_top_level": ["positions", "base_currency"],
  "exchange_rate_convention": "one unit of position currency in base currency",
  "exchange_rate_metadata_contract": {
    "shape": "object keyed by the position currency used in exchange_rates",
    "required_fields": ["pair", "as_of", "source", "source_locator", "retrieved_at"],
    "pair_format": "POSITION_CURRENCY/BASE_CURRENCY",
    "status_without_metadata": "undated_static",
    "status_with_valid_metadata": "dated_snapshot",
    "realtime_claim_allowed": false
  },
  "quantity_semantics": {
    "active_holding": "quantity > 0",
    "inactive_audit_record": "quantity == 0",
    "invalid_record": "quantity < 0",
    "inactive_exclusions": [
      "market value",
      "portfolio weight",
      "risk aggregation",
      "monitoring-boundary evaluation",
      "scenario analysis"
    ]
  },
  "current_weight_range": "0 <= current_weight <= 1; quantity == 0 requires current_weight == 0",
  "persisted_current_weight_semantics": "accepted only for stale-state audit, stripped on load, and never treated as a current weight without a separately verified quote snapshot",
  "required_position_fields": ["symbol", "quantity", "avg_cost", "currency", "market", "asset_type"],
  "position_field_types": {
    "symbol": "non-empty string",
    "quantity": "JSON number; bool and numeric string prohibited",
    "avg_cost": "JSON number; bool and numeric string prohibited",
    "currency": "three-letter string currency code",
    "market": "uppercase string from allowed_markets",
    "asset_type": "lowercase string from allowed_asset_types",
    "current_weight": "JSON number; bool and numeric string prohibited"
  },
  "allowed_markets": [
    "CN",
    "HK",
    "US",
    "CASH"
  ],
  "allowed_asset_types": [
    "stock",
    "etf",
    "fund",
    "index",
    "cash",
    "other"
  ],
  "cash_identity_rule": "symbol CASH or CASH_* if and only if market is CASH and asset_type is cash",
  "legacy_display_fields_ignored_for_identity": [
    "market_type"
  ],
  "optional_position_fields": [
    "name",
    "opened_at",
    "current_weight",
    "target_weight",
    "max_weight",
    "thesis",
    "average_daily_value",
    "days_to_liquidate",
    "allocation_bucket"
  ],
  "ignored_derived_position_fields": ["current_weight"],
  "user_authorized_constraint_fields": ["target_weight", "max_weight"],
  "constraint_field_semantics": "input-only user constraints; never generated, redistributed, or written by allocation experiments",
  "risk_profile_required_fields_when_configured": [
    "high_concentration_threshold",
    "medium_concentration_threshold",
    "max_market_exposure_high",
    "max_market_exposure_medium",
    "max_single_stock_weight",
    "liquidity_high_days",
    "liquidity_medium_days",
    "provenance"
  ],
  "risk_profile_required_provenance_fields": [
    "source_type",
    "source",
    "as_of_date",
    "region",
    "purpose"
  ]
}
