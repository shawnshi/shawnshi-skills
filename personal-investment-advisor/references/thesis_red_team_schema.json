{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pia_thesis_red_team_v1",
  "title": "PIA Daily Sync Thesis red-team evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "window_start",
    "window_end",
    "portfolio_snapshot_binding",
    "scope_coverage",
    "assessments",
    "evidence_items"
  ],
  "properties": {
    "schema_version": {"const": "pia_thesis_red_team_v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "portfolio_snapshot_binding": {"type": "object"},
    "scope_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macro", "sector", "regulatory"],
      "properties": {
        "macro": {"$ref": "#/$defs/coverage"},
        "sector": {"$ref": "#/$defs/coverage"},
        "regulatory": {"$ref": "#/$defs/coverage"}
      }
    },
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"enum": ["complete", "insufficient_evidence"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "conclusion", "rationale", "evidence_ids"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "conclusion": {
          "enum": [
            "fatal_breach",
            "no_fatal_breach_verified",
            "insufficient_evidence"
          ]
        },
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_tier",
        "source_locator",
        "published_at",
        "retrieved_at",
        "content_sha256",
        "claim"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_tier": {
          "enum": [
            "issuer",
            "exchange",
            "regulator",
            "audited_filing",
            "official_product_data"
          ]
        },
        "source_locator": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "published_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "claim": {"type": "string", "minLength": 1}
      }
    }
  }
}
