{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pia-active-construction-policy-v1",
  "type": "object",
  "required": ["schema_version", "decision_scope", "as_of", "symbols", "current_weights", "risk_budgets", "minimum_weights", "maximum_weights", "covariance", "risk_aversion", "transaction_cost_bps", "cost_evidence", "step_size", "tolerance", "max_iterations", "max_one_way_turnover", "max_trade_weight"],
  "properties": {
    "schema_version": {"const": "pia_active_construction_policy_v1"},
    "decision_scope": {"const": "research_only"},
    "as_of": {"type": "string", "format": "date-time"},
    "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_weights": {"$ref": "#/$defs/weights"},
    "risk_budgets": {"$ref": "#/$defs/weights"},
    "minimum_weights": {"$ref": "#/$defs/weights"},
    "maximum_weights": {"$ref": "#/$defs/weights"},
    "covariance": {"type": "object", "required": ["symbols", "matrix", "observation_count", "window_start", "window_end", "as_of", "source_locator", "content_sha256"], "properties": {"symbols": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "matrix": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}}, "observation_count": {"type": "integer", "minimum": 2}, "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"}, "as_of": {"type": "string", "format": "date-time"}, "source_locator": {"type": "string"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "risk_aversion": {"type": "number", "exclusiveMinimum": 0},
    "transaction_cost_bps": {"type": "number", "minimum": 0},
    "cost_evidence": {"type": "object", "required": ["observed_at", "source_locator", "content_sha256"], "properties": {"observed_at": {"type": "string", "format": "date-time"}, "source_locator": {"type": "string"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "step_size": {"type": "number", "exclusiveMinimum": 0},
    "tolerance": {"type": "number", "exclusiveMinimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_one_way_turnover": {"type": "number", "minimum": 0, "maximum": 1},
    "max_trade_weight": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {"weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}},
  "additionalProperties": false
}
